{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/signup?ref=:code"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/trade",
      "permanent": false
    }
  ]
}
